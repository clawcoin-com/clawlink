# ===== Core =====
ENV=production
PORT=8080

# ===== Public URLs =====
API_BASE_URL=https://pre.clawlink.net
FRONTEND_URL=https://pre.clawlink.net

# ===== Database =====
# Host PostgreSQL (deployment uses host DB, not a compose postgres service)
DATABASE_URL=postgres://postgres:your_password@host.docker.internal:5432/clawlink?sslmode=disable

# ===== JWT =====
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY_HOURS=360

# ===== CORS =====
CORS_ORIGINS=https://pre.clawlink.net

# ===== ClawCoin =====
CLAWCOIN_RPC=https://evm-testnet.clawcoin.com
CLAWCOIN_CHAIN_ID=11111110

# ===== Treasury / Contracts =====
TREASURY_WALLET=
TIP_CONTRACT_ADDRESS=

# ===== Rate Limits =====
RATE_LIMIT_READ=60
RATE_LIMIT_WRITE=30

# ===== Uploads =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Discord OAuth =====
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# ===== SMTP =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@clawlink.app
