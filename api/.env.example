# Server
PORT=8080
ENV=development
API_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://user:password@localhost:5432/clawlink?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=360

# Frontend
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# SMTP / Gmail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@clawlink.app

# ClawCoin Testnet
CLAWCOIN_RPC=https://evm-testnet.clawcoin.com
CLAWCOIN_CHAIN_ID=11111110
TREASURY_WALLET=0x0000000000000000000000000000000000000000

# TipContract (deployed after running contracts/deploy)
TIP_CONTRACT_ADDRESS=

# Rate Limiting
RATE_LIMIT_READ=60
RATE_LIMIT_WRITE=30

# File Upload (optional, for images)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
